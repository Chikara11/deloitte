# GCP Project Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1

# Storage & Data
GCS_QUARANTINE_BUCKET=war-room-quarantine-your-project
BQ_DATASET=war_room
BQ_LEDGER_TABLE=ledger_2025
BQ_AUDIT_TABLE=audit_logs
FIRESTORE_COLLECTION=deal_chunks

# Models
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-005

# Security & Guardrails
USE_REAL_DLP=true
USE_REAL_MODEL_ARMOR=true
USE_REAL_IAM_IMPERSONATION=true
DLP_HMAC_SECRET=hackathon-demo-secret-rotate-in-kms

# Service Accounts (created by scripts/setup_gcp.sh)
SA_LEGAL_EMAIL=sa-legal@your-gcp-project-id.iam.gserviceaccount.com
SA_QUANT_EMAIL=sa-quant@your-gcp-project-id.iam.gserviceaccount.com
SA_FORENSIC_EMAIL=sa-forensic@your-gcp-project-id.iam.gserviceaccount.com
